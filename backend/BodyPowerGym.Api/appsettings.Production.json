{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "AutoMigrate": true,
    "AutoSeed": false
  },
  "ReminderService": {
    "Enabled": true,
    "IntervalHours": 24
  }
}
